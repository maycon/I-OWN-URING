[6.892784, "o", "\u001b[?25l\u001b[1;3H ─ maycon@codeforge:~/github/maycon/uring-shellcode ─────────────────────────────────────────────\u001b(B\u001b[m\u001b[32m\u001b[29;3H ─ tail -f /tmp/poc/demo_c2.log ─────────────────────────────────────────────────────────────────\u001b(B\u001b[m\u001b[1;105H ─ maycon@codeforge:~/github/maycon/uring-shellcode ────────────────────────────────\u001b[H──\u001b[97C──┬──\u001b[84C──\u001b[2;102H│\u001b[3;102H│\u001b[4;102H│\u001b[5;102H│\u001b[6;102H│\u001b[7;102H│\u001b[8;102H│\u001b[9;102H│\u001b[10;102H│\u001b[11;102H│\u001b[12;102H│\u001b[13;102H│\u001b[14;102H│\u001b[15;102H│\u001b[16;102H│\u001b[17;102H│\u001b[18;102H│\u001b[19;102H│\u001b[20;102H│\u001b[21;102H│\u001b[22;102H│\u001b[23;102H│\u001b[24;102H│\u001b[25;102H│\u001b[26;102H│\u001b[27;102H│\u001b[28;102H│\r\n\u001b[32m──\u001b[97C──┤\u001b[30;102H│\u001b[31;102H│\u001b[32;102H│\u001b[33;102H│\u001b[34;102H│\u001b[35;102H│\u001b[36;102H│\u001b[37;102H│\u001b[38;102H│\u001b[39;102H│\u001b(B\u001b[m\u001b[2;1H$ printf '\\033[36;1m uring-shellcode — EDR-visibility demo (falco 0.45.1, default rules only)\\033[0m\\\u001b[3;101H\u001b[1K\rn'\u001b[36m\u001b[1m\r\n uring-shellcode — EDR-visibility demo (falco 0.45.1, default rules only)\u001b(B\u001b[m\u001b[28X\r\n$ \u001b[32mprintf\u001b[39m \u001b[33m'\\033[36m  left: commands  |  right: live falco  |  bottom-left: host C2 output\\033[0m\\n'\u001b[39m\u001b[3X\u001b[36m\r\n  left: commands  |  right: live falco  |  bottom-left: host C2 output\u001b[39m\u001b[31X\r\n$ \u001b[32mprintf\u001b[39m \u001b[33m'\\033[33m  ── setup: launch falco privileged container, NO custom ruleset ──\\033[0m\\n'\u001b[39m\u001b[6X\u001b[33m\r\n  ── setup: launch falco privileged container, NO custom ruleset ──\u001b[39m\u001b[34X\r\n$ \u001b[32mdocker\u001b[39m run -d --name flk --privileged --network host -e HOST_ROOT=/host -v /tmp/poc:/lab:ro\u001b[90m -v /pro\r\nc:/host/proc:ro -v /sys:/host/sys:ro -v /etc:/host/etc:ro falcosecurity/falco:0.45.1-debian falco -c \u001b[39m\u001b[11;101H\u001b[1K\u001b[90m\r/etc/falco/falco.yaml -o webserver.enabled=false\u001b[39m\u001b[12;101H\u001b[1K\n\u001b[1K\n\u001b[1K\n\u001b[1K\n\u001b[1K\n\u001b[1K\n\u001b[1K\n\u001b[1K\n\u001b[1K\n\u001b[1K\n\u001b[1K\n\u001b[1K\n\u001b[1K\n\u001b[1K\n\u001b[1K\n\u001b[1K\n\u001b[1K\u001b[2B\u001b[1K\r$ \u001b[32mtail\u001b[39m -f \u001b[4m/tmp/poc/demo_c2.log\u001b(B\u001b[m\u001b[31;101H\u001b[1K\n\u001b[1K\n\u001b[1K\n\u001b[1K\n\u001b[1K\n\u001b[1K\n\u001b[1K\n\u001b[1K\n\u001b[1K\u001b[2;103H$ \u001b[K\u001b[3;103H\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\u001b[30m\u001b[42m\r\n[demo] 1:main*                                                                                                                                         \"tail -f /tmp/poc/demo\" 20:28 23-Oct-26\u001b(B\u001b[m\u001b[?12l\u001b[?25h\u001b[31;1H"]
