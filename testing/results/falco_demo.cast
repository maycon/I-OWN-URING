[64.652754, "o", "\u001b[?25l\u001b[2;101H\u001b[1K\u001b[33m\rve ══\\033[0m\\n'\u001b[36m\r\n══ SCENARIO 1 — pure-syscall baseline (cbsys.bin): socket → connect → dup2×3 → execve ══\u001b[39m\u001b[13X\r\n$ \u001b[32mdocker\u001b[39m exec flk /lab/runner /lab/cbsys.bin                                                   \u001b[6X\u001b[5;101H\u001b[1K\r[*] Loaded 127 bytes from /lab/cbsys.bin\u001b[6;101H\u001b[1K\r[*] Config offsets found by scan: IP=121 PORT=125\u001b[7;101H\u001b[1K\r[*] Shellcode at 0x78710c619000 — executing...\r\n$ \u001b[32mprintf\u001b[39m \u001b[33m\"     stock-rule rows: %s\\n\"\u001b[39m \u001b[33m\"\u001b[35m$(\u001b[32mdocker\u001b[39m logs flk \u001b[33m2>&\u001b[39m1 | \u001b[32mgrep\u001b[39m -c \u001b[33m\"Notice Redirect\"\u001b[35m)\u001b[33m\"\u001b[39m\u001b[10X\u001b[9;101H\u001b[1K\r     stock-rule rows: 3\r\n$ \u001b[32mprintf\u001b[39m \u001b[33m'\\033[32m  ✔ DETECTED out of the box — 3 rows, one per dup2 of the connected socket; zero tu\u001b[39m\u001b[11;101H\u001b[1K\u001b[33m\rning\\033[0m\\n'\u001b[32m\r\n  ✔ DETECTED out of the box — 3 rows, one per dup2 of the connected socket; zero tuning\u001b[39m\u001b[14X\r\n$ \u001b[32mprintf\u001b[39m \u001b[33m'\\033[36m══ SCENARIO 2 — io_uring classic (cb_uring.bin): socket/connect via io_uring_enter \u001b[39m\u001b[14;101H\u001b[1K\u001b[33m\r══\\033[0m\\n'\u001b[36m\r\n══ SCENARIO 2 — io_uring classic (cb_uring.bin): socket/connect via io_uring_enter ══\u001b[39m\u001b[16X\u001b[16;101H\u001b[1K\r$ \u001b[32mdocker\u001b[39m exec flk /lab/runner /lab/cb_uring.bin\u001b[17;101H\u001b[1K\r[*] Loaded 834 bytes from /lab/cb_uring.bin\u001b[18;101H\u001b[1K\r[*] Config offsets found by scan: IP=820 PORT=824\u001b[19;101H\u001b[1K\r[*] Shellcode at 0x7150e2b73000 — executing...\r\n$ \u001b[32mprintf\u001b[39m \u001b[33m\"     stock-rule rows: %s  ← unchanged, no new rows\\n\"\u001b[39m \u001b[33m\"\u001b[35m$(\u001b[32mdocker\u001b[39m logs flk \u001b[33m2>&\u001b[39m1 | \u001b[32