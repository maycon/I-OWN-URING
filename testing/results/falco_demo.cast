[48.817108, "o", "\u001b[?25l\u001b[2d$ \u001b[32mprintf\u001b[39m \u001b[33m'\\033[33m  ── setup: launch falco privileged container, NO custom ruleset ──\\033[0m\\n'\u001b[39m\u001b[6X\u001b[33m\r\n  ── setup: launch falco privileged container, NO custom ruleset ──\u001b[39m\u001b[34X\r\n$ \u001b[32mdocker\u001b[39m run -d --name flk --privileged --network host -e HOST_ROOT=/host -v /tmp/poc:/lab:ro -v /pro\r\nc:/host/proc:ro -v /sys:/host/sys:ro -v /etc:/host/etc:ro falcosecurity/falco:0.45.1-debian falco -c \u001b[6;101H\u001b[1K\u001b[4m\r/etc/falco/falco.yaml\u001b(B\u001b[m -o webserver.enabled=false\r\n63b05a0ca638c0e93205dec8dceb031bd8d52baeac39be71ecb2baa585603d2f\u001b[37X\r\n$ \u001b[32mprintf\u001b[39m \u001b[33m'\\033[0m  (waiting for the BPF probe to attach…)\\033[0m\\n'\u001b[39m\u001b[34X\u001b[9;101H\u001b[1K\r  (waiting for the BPF probe to attach…)\r\n$ \u001b[32mprintf\u001b[39m \u001b[33m'\\033[0m  probe attached. nothing suspicious has happened yet — right pane silent.\\033[0m\\n'\u001b[39m\u001b[11;101H\u001b[1K\r \r\n  probe attached. nothing suspicious has happened yet — right pane silent.\u001b[27X\r\n$ \u001b[32mprintf\u001b[39m \u001b[33m'\\033[36m══ SCENARIO 1 — pure-syscall baseline (cbsys.bin): socket → connect → dup2×3 → exec\u001b[39m\u001b[14;101H\u001b[1K\u001b[33m\rve ══\\033[0m\\n'\u001b[36m\r\n══ SCENARIO 1 — pure-syscall baseline (cbsys.bin): socket → connect → dup2×3 → execve ══\u001b[39m\u001b[13X\r\n$ \u001b[32mdocker\u001b[39m exec flk /lab/runner /lab/cbsys.bin                                                   \u001b[6X\u001b[17;101H\u001b[1K\r[*] Loaded 127 bytes from /lab/cbsys.bin\u001b[18;101H\u001b[1K\r[*] Config offsets found by scan: IP=121 PORT=125\u001b[19;101H\u001b[1K\r[*] Shellcode at 0x78710c619000 — executing...\r\n$ \u001b[32mprintf\u001b[39m \u001b[33m\"     stock-rule rows: %s\\n\"\u001b[39m \u001b[33m\"\u001b[35m$(\u001b[32mdocker\u001b[39m logs flk \u001b[33m2>&\u001b[39m1 | \u001b[32mgrep\u001b[39m -c \